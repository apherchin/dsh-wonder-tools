{
  "name": "dsh-wonder-tools",
  "version": "0.2.0",
  "description": "DSH 工具箱（装配包）：一个插件装好五个功能 —— 删除对话 / 重新生成（从这里重来）/ 队友命令（/teammate）/ 跨会话提醒 / 首轮结束自动命名。",
  "icon": "./icon.svg",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "dsh-plugin",
    "toolbox"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apherchin/dsh-wonder-tools.git"
  },
  "homepage": "https://github.com/apherchin/dsh-wonder-tools#readme",
  "bugs": {
    "url": "https://github.com/apherchin/dsh-wonder-tools/issues"
  },
  "license": "MIT",
  "author": {
    "name": "apherchin"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@apherchin/dsh-session-delete": "0.1.3",
    "@apherchin/dsh-session-rewind": "0.1.1",
    "dsh-sidefork-a-teammate": "0.2.1",
    "dsh-windows-session-notification": "0.1.3",
    "dsh-rename-title-after-first-turn": "0.1.0"
  }
}
